*.backup.gz
database_backups/
db_backups/

# =========================================================
# 6. DJANGO MIGRATION RULES
# =========================================================
# Keep migration source files in Git.
# Do NOT ignore your migrations/ directories.
# Only ignore Python bytecode, already covered above.

